# Copy this to .env and fill in your values
# Copy this file to .env and fill in your values.

# ─── LLM Provider ────────────────────────────────────────
# OpenRouter is the primary provider (OpenAI-compatible). Paste your key here.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fallback: use OpenAI directly if OPENROUTER_API_KEY is left empty.
OPENAI_API_KEY=

# ─── Supabase (optional) ─────────────────────────────────
# Only needed for auth + saved history. Core code analysis (/analyze) works
# without these; auth/history endpoints return 503 until they are set.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Database / Server / Sandbox ─────────────────────────
CHROMA_DB_PATH=./datasets/chroma_db
HOST=0.0.0.0
PORT=8000
SANDBOX_TIMEOUT=10
SANDBOX_MEMORY_LIMIT=128
